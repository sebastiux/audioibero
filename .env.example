# Railway inyecta DATABASE_URL automáticamente al vincular el servicio de Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/audioibero"

# Secreto para firmar las sesiones (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+"

# Correo (Resend): invitaciones, recuperar contraseña y recordatorios
RESEND_API_KEY="re_xxxxxxxxx"
# Remitente con un dominio verificado en Resend (sin dominio puedes probar con onboarding@resend.dev)
EMAIL_FROM="Audio Ibero <lab@tudominio.mx>"
# URL pública de la app, para los enlaces de los correos
APP_URL="https://tu-app.up.railway.app"
# Secreto para el aviso diario de recordatorios: GET /api/cron/reminders con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="otro-secreto-largo"

# Admin inicial (se crea/actualiza al arrancar con `npm run db:seed`)
ADMIN_EMAIL="admin@audioibero.mx"
ADMIN_PASSWORD="cambia-esta-contraseña"
ADMIN_NAME="Admin Audio Ibero"

# Zona horaria del laboratorio (horarios de apertura y calendario recomendado)
APP_TIMEZONE="America/Mexico_City"
