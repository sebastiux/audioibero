generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

/// LAB = uso libre del laboratorio; PROJECT = trabajo en un proyecto de equipo.
enum SlotKind {
  LAB
  PROJECT
}

enum AssignmentSource {
  MANUAL
  RECOMMENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingsCreated    Booking[]            @relation("BookingCreator")
  bookings           BookingParticipant[]
  projectMemberships ProjectMember[]
  projectsCreated    Project[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#7c3aed")
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id])
  members   ProjectMember[]
  bookings  Booking[]
}

model ProjectMember {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Reserva de horario en el lab. LAB = trabajo individual/libre; PROJECT = sesión de equipo.
/// Varios miembros pueden participar en la misma reserva (se unen desde el calendario).
model Booking {
  id          String           @id @default(cuid())
  start       DateTime
  end         DateTime
  kind        SlotKind         @default(LAB)
  projectId   String?
  notes       String?
  source      AssignmentSource @default(MANUAL)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy    User                 @relation("BookingCreator", fields: [createdById], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants BookingParticipant[]

  @@index([start, end])
}

model BookingParticipant {
  bookingId String
  userId    String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookingId, userId])
  @@index([userId])
}

/// Configuración única del laboratorio (fila con id = 1).
model LabSettings {
  id                    Int      @id @default(1)
  capacity              Int      @default(4)
  openMinute            Int      @default(480)
  closeMinute           Int      @default(1260)
  /// Días abiertos, 0 = domingo ... 6 = sábado.
  openDays              Int[]    @default([1, 2, 3, 4, 5])
  slotMinutes           Int      @default(30)
  /// Tope semanal de horas por miembro (referencia y límite para el calendario recomendado)
  maxWeeklyMinutes      Int      @default(600)
  /// Calendario recomendado: horas de sesión de equipo por proyecto a la semana y duración de cada sesión
  projectWeeklyMinutes  Int      @default(240)
  projectSessionMinutes Int      @default(120)
  updatedAt             DateTime @updatedAt
}
