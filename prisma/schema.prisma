generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

/// LAB = trabajo en el laboratorio; PROJECT = sesión de equipo en el lab;
/// ASYNC = trabajo asíncrono fuera del lab (no ocupa cupo), opcionalmente ligado a un proyecto.
enum SlotKind {
  LAB
  PROJECT
  ASYNC
}

/// REMINDER = recordatorio; RECURRING = sesión fija que se repite cada semana (definida por el admin).
enum MissionType {
  REMINDER
  RECURRING
}

/// INVITE = activar cuenta (la crea el admin); RESET = recuperar contraseña.
enum TokenType {
  INVITE
  RESET
}

enum AttendanceStatus {
  GOING
  NOT_GOING
}

enum AssignmentSource {
  MANUAL
  RECOMMENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// Nulo mientras la persona no activa su cuenta desde el correo de invitación.
  passwordHash String?
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Horario de clases Ibero: calendario .ics o materias leídas del PDF "Materias inscritas"
  /// (sólo materia, salón, día, horario y vigencia). Se usa para proponer horarios libres.
  iberoIcs          String?
  iberoClasses      Json?
  iberoIcsUpdatedAt DateTime?

  invitedAt   DateTime?
  activatedAt DateTime?
  authTokens  AuthToken[]
  attendances MissionAttendance[]

  bookingsCreated    Booking[]            @relation("BookingCreator")
  missionsCreated    Mission[]
  bookings           BookingParticipant[]
  projectMemberships ProjectMember[]
  projectsCreated    Project[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#7c3aed")
  active      Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id])
  members   ProjectMember[]
  bookings  Booking[]
  missions  Mission[]
}

model ProjectMember {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// Reserva de horario en el lab. LAB = trabajo individual/libre; PROJECT = sesión de equipo.
/// Varios miembros pueden participar en la misma reserva (se unen desde el calendario).
model Booking {
  id          String           @id @default(cuid())
  start       DateTime
  end         DateTime
  kind        SlotKind         @default(LAB)
  projectId   String?
  notes       String?
  source      AssignmentSource @default(MANUAL)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy    User                 @relation("BookingCreator", fields: [createdById], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  participants BookingParticipant[]

  @@index([start, end])
}

model BookingParticipant {
  bookingId String
  userId    String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookingId, userId])
  @@index([userId])
}

/// Actividad de un proyecto: recordatorio o sesión fija recurrente predefinida por el admin.
/// Sin proyecto (projectId nulo) aplica a todo el club.
model Mission {
  id            String      @id @default(cuid())
  projectId     String?
  title         String
  description   String?
  type          MissionType @default(REMINDER)
  pinned        Boolean     @default(false)
  active        Boolean     @default(true)
  /// Recordatorio: fecha límite opcional
  dueDate       DateTime?
  /// Último envío por correo (manual o al guardar) y aviso automático del día de la fecha
  emailedAt     DateTime?
  dueNotifiedAt DateTime?
  /// Sesión recurrente: días (0 = domingo ... 6 = sábado), horario local en minutos y vigencia
  weekdays      Int[]       @default([])
  startMinute   Int?
  endMinute     Int?
  startsOn      DateTime?
  endsOn        DateTime?
  /// LAB = presencial en el lab; ASYNC = remota
  kind          SlotKind    @default(LAB)
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  createdBy   User                @relation(fields: [createdById], references: [id])
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendances MissionAttendance[]

  @@index([projectId])
}

/// Confirmación de asistencia a una sesión fija. `date` = YYYY-MM-DD de la fecha (hora del club);
/// vacío ("") = respuesta para todas las semanas. Una respuesta de fecha concreta tiene prioridad.
model MissionAttendance {
  id        String           @id @default(cuid())
  missionId String
  userId    String
  date      String           @default("")
  status    AttendanceStatus
  updatedAt DateTime         @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId, date])
  @@index([missionId, date])
}

/// Enlace de un solo uso enviado por correo. Sólo se guarda el hash del token.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Configuración única del laboratorio (fila con id = 1).
model LabSettings {
  id          Int      @id @default(1)
  openMinute  Int      @default(480)
  closeMinute Int      @default(1260)
  /// Días abiertos, 0 = domingo ... 6 = sábado.
  openDays    Int[]    @default([1, 2, 3, 4, 5])
  slotMinutes Int      @default(30)
  updatedAt   DateTime @updatedAt
}
