{
  "name": "audioibero",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de organización del Club de Audio Ibero: disponibilidad, asignaciones, proyectos y calendario recomendado.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "start:railway": "prisma migrate deploy && node prisma/seed.mjs && next start -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "jose": "6.1.0",
    "next": "15.5.28",
    "prisma": "6.19.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
